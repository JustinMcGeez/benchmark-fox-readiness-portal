# Benchmark Fox Readiness Portal — environment variables (EXAMPLE)
#
# Copy this file to `.env.local` and fill in real values. NEVER commit real
# secrets. `.env.local` / `.env*` are gitignored; this `.env.example` is the
# only env file that belongs in version control.
#
# These are OPTIONAL during the MVP — the app runs on localStorage when they are
# unset (see src/lib/supabaseClient.ts and docs/backend/supabase-architecture.md).
#
# Only Vite `VITE_`-prefixed vars are exposed to the browser bundle. The anon key
# is a PUBLIC key (safe to ship); access is enforced by Row Level Security in
# Postgres. NEVER put the Supabase service_role key in a VITE_ var or the client.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — Sentry DSN for browser error monitoring. When unset, monitoring is
# fully disabled and Sentry is never loaded (the app runs identically). The DSN
# is a PUBLIC value (safe to ship). Only error type/message/stack are sent — see
# beforeSend in src/lib/monitoring.ts and the README "Error monitoring & privacy"
# section. NEVER use a Sentry auth token here; the DSN is all the browser needs.
VITE_SENTRY_DSN=

# ----------------------------------------------------------------------------
# SERVER-SIDE ONLY — used by Node scripts, NEVER by the browser bundle.
# These are read by the seeding scripts (db:seed:refs / db:seed:demo) and the
# RLS test harness (test:rls). The service_role key BYPASSES Row Level Security:
# keep it server-only, never put it in a VITE_ var, and never commit a real value.
# Locally, get these from `supabase status -o env` after `supabase start`
# (API_URL -> SUPABASE_URL, ANON_KEY -> SUPABASE_ANON_KEY,
#  SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
