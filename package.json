{
  "name": "benchmark-fox-readiness-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Benchmark Fox Readiness Portal — CMMC readiness command center (wireframe MVP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "import:sources": "node scripts/import-sp800-171.ts",
    "validate:controls": "node scripts/validate-controls.mjs",
    "validate:scoring": "node scripts/validate-scoring.mjs",
    "validate:objectives": "node scripts/validate-assessment-objectives.mjs",
    "validate:guidance": "node scripts/validate-benchmarkfox-guidance.mjs",
    "check:sourcerefs": "node scripts/check-sourcerefs.mjs",
    "check:supabase-readonly": "node scripts/check-supabase-readonly-integration.mjs",
    "build:data": "npm run import:sources && npm run validate:controls && npm run validate:scoring && npm run validate:objectives && npm run validate:guidance && npm run check:sourcerefs",
    "db:seed:refs": "node scripts/seed-supabase-reference-data.ts",
    "db:validate": "node scripts/validate-supabase-schema.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.8"
  }
}
