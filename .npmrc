# This network uses a TLS-intercepting proxy, which makes npm fail with
# UNABLE_TO_VERIFY_LEAF_SIGNATURE on every request. Disabling strict-ssl is the
# standard workaround. If/when you can point npm at the proxy's root CA instead,
# prefer that and remove this line:
#   npm config set cafile "C:\\path\\to\\proxy-root-ca.pem"
strict-ssl=false
fund=false
audit=false
